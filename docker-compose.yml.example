# Copy to docker-compose.yml, set PROXY_UPSTREAM_URL in .env,
# and start with: docker compose up -d --build
# Client setup: README.md | Configuration reference: docs/CONFIGURATION.md
services:
  proxy:
    build:
      context: .
      args:
        VERSION: "${PROXY_VERSION:-}"
        COMMIT: "${PROXY_COMMIT:-}"
        BUILD_DATE: "${PROXY_BUILD_DATE:-}"
        DIRTY: "${PROXY_DIRTY:-unknown}"
    image: steady-proxy:latest
    # Run as host user so ./logs archives are owned by you instead of root.
    # Set UID and GID in .env if your user is not 1000:1000.
    user: "${UID:-1000}:${GID:-1000}"
    environment:
      PROXY_LISTEN_ADDR: "0.0.0.0:8789"
      PROXY_UPSTREAM_URL: "${PROXY_UPSTREAM_URL:?set PROXY_UPSTREAM_URL in .env to your real gateway}"
      PROXY_SDK_RETRY_CAP: "${PROXY_SDK_RETRY_CAP:-100}"
      PROXY_TRANSACTIONAL_LOCAL_RETRIES: "${PROXY_TRANSACTIONAL_LOCAL_RETRIES:-0}"
      PROXY_LOCAL_RETRY_EXTRA_BACKOFF_CAP_MS: "${PROXY_LOCAL_RETRY_EXTRA_BACKOFF_CAP_MS:-10000}"
      PROXY_KEEPALIVE_MS: "${PROXY_KEEPALIVE_MS:-600000}"
      PROXY_WORKFLOW_KEEPALIVE_MS: "${PROXY_WORKFLOW_KEEPALIVE_MS:-10000}"
      PROXY_RESPONSES_KEEPALIVE_MS: "${PROXY_RESPONSES_KEEPALIVE_MS:-30000}"
      PROXY_RESPONSES_BUFFER_MS: "${PROXY_RESPONSES_BUFFER_MS:-600000}"
      PROXY_GEMINI_BUFFER_MS: "${PROXY_GEMINI_BUFFER_MS:-600000}"
      PROXY_RESPONSES_EARLY_COMMIT: "${PROXY_RESPONSES_EARLY_COMMIT:-1}"
      PROXY_RESPONSES_REPLAY_DELTA_BYTES: "${PROXY_RESPONSES_REPLAY_DELTA_BYTES:-65536}"
      PROXY_RESP_HEADER_TIMEOUT_MS: "${PROXY_RESP_HEADER_TIMEOUT_MS:-660000}"
      PROXY_UPSTREAM_BYTE_IDLE_MS: "${PROXY_UPSTREAM_BYTE_IDLE_MS:-600000}"
      PROXY_VALIDATE_JSON: "${PROXY_VALIDATE_JSON:-1}"
      PROXY_NORMALIZE_TOOL_JSON: "${PROXY_NORMALIZE_TOOL_JSON:-1}"
      PROXY_REFUSAL_FALLBACK_MODEL: "${PROXY_REFUSAL_FALLBACK_MODEL-claude-opus-5}"
      PROXY_REQUEST_LOG_DIR: "${PROXY_REQUEST_LOG_DIR:-}"
      PROXY_VERBOSE: "${PROXY_VERBOSE:-1}"
    volumes:
      - ./logs:/logs
    ports:
      - "127.0.0.1:8789:8789" # loopback only — never expose publicly
    restart: unless-stopped
