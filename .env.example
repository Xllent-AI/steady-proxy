# Copy to .env and set PROXY_UPSTREAM_URL. Docker Compose loads .env automatically.
# Apply changes with: docker compose up -d
# Note: the native binary reads process environment variables directly, not .env.
# Docs: README.md (setup) | docs/CONFIGURATION.md (full reference)

# Required. Gateway root URL (http/https, optional path prefix, usually no trailing /v1).
# Incoming paths like /v1/messages are appended directly to this URL.
PROXY_UPSTREAM_URL=

# Host user/group IDs for container file ownership (used when writing ./logs).
# Uncomment and set to `id -u` / `id -g` if your host user is not 1000:1000.
#UID=1000
#GID=1000

# Anthropic Messages buffering window (4m default).
# Client timeouts must exceed this value. In ~/.claude/settings.json:
#   CLAUDE_CODE_CONNECT_TIMEOUT_MS=660000
#   API_TIMEOUT_MS=720000
#   API_FORCE_IDLE_TIMEOUT=0
PROXY_KEEPALIVE_MS=240000

# Claude Code Workflow agent window (10s default). Keeps buffering below the
# Workflow runtime's content-stall watchdog (stallMs). 0 disables the timed live switch.
PROXY_WORKFLOW_KEEPALIVE_MS=10000

# Abort an upstream SSE stream or error read after 10m with no bytes received.
PROXY_UPSTREAM_BYTE_IDLE_MS=600000

# OpenAI Responses silent-start window (30s default) when early commit is enabled.
PROXY_RESPONSES_KEEPALIVE_MS=30000

# OpenAI Responses full-buffering window (4m default) when early commit is disabled.
# Set Codex stream_idle_timeout_ms=660000 to cover this window.
PROXY_RESPONSES_BUFFER_MS=240000

# Set to 0 to buffer Responses streams until completion (or the buffer window ends).
#PROXY_RESPONSES_EARLY_COMMIT=1

# Native Gemini streamGenerateContent?alt=sse buffering window (4m default).
# 0 buffers until completion without a timed live switch.
PROXY_GEMINI_BUFFER_MS=240000

# Extra in-proxy retries for recoverable streaming failures before commit.
# 0 keeps only a single fast retry (<3s failure, 250ms wait) for connection/HTTP errors.
PROXY_TRANSACTIONAL_LOCAL_RETRIES=0

# Cap on the exponential backoff added on top of upstream Retry-After during local retries.
PROXY_LOCAL_RETRY_EXTRA_BACKOFF_CAP_MS=10000

# Backstop on X-Stainless-Retry-Count (does not raise client retry limits; ignored by
# clients that do not send the header, such as Codex). 0 disables retry conversion.
#PROXY_SDK_RETRY_CAP=100

# Claude models only: retry pre-commit structured refusals or recognized Fable safeguard
# errors once with this model; if it fails, the original answer is delivered.
# Set to off, none, disabled, or empty to disable.
#PROXY_REFUSAL_FALLBACK_MODEL=claude-opus-5

# Optional directory for full JSON request/response archives (mapped to ./logs in Compose).
# Archives are unencrypted (auth headers/params redacted, bodies raw) with no auto-retention.
#PROXY_REQUEST_LOG_DIR=./logs
