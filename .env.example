# Copy to .env (gitignored) and set your real values.
# docker compose reads .env automatically.

# The real gateway the proxy forwards to. Keep this out of version control.
PROXY_UPSTREAM_URL=https://your-gateway.example.com

# Transactional window. Stay buffered (cleanly convertible) up to this long,
# then commit + stream live. BOTH client-side abort timers MUST exceed it, or
# Claude aborts mid-hold. In ~/.claude/settings.json set:
#   CLAUDE_CODE_CONNECT_TIMEOUT_MS=660000   (TTFB / no-response-headers ceiling)
#   API_TIMEOUT_MS=720000                   (hard per-attempt request timeout)
#   API_FORCE_IDLE_TIMEOUT=0                (keep off; on kills a transactional hold)
PROXY_KEEPALIVE_MS=600000

# Workflow agents ONLY: a SMALL transactional window. Claude Code's Workflow
# tool aborts any agent() whose stream shows no forwarded assistant/tool delta for
# its per-agent "stall" budget (default 180000ms, retried, with NO global env
# override); only real streamed deltas reset it (keepalive comments and ping
# events do NOT). Precisely: it kills when (client's last forwarded content delta
# + stallMs) elapses. Full buffering (PROXY_KEEPALIVE_MS=600000) forwards nothing,
# so the first gap is unbounded and a long workflow turn is killed at ~180s. This
# window makes the proxy commit + stream live for workflow agents (detected by
# their system prompt) so forwarded deltas feed the watchdog. Keep it SMALL: while
# buffering the proxy forwards nothing, so the FIRST gap (query start -> first
# forwarded delta) is ~= window + upstream TTFB; a small window holds that first
# gap under stallMs. A large window (e.g. 120000) is not automatically fatal — a
# steady stream can survive it — but it pushes the first gap toward stallMs and
# delays going live, so small is the safe default. Once streaming, only the
# upstream's own content-delta gaps matter; the proxy CANNOT rescue a mid-turn
# content-silent pause >= stallMs (server-side reasoning emitting only pings, or a
# slow first byte under effort:'high') — only a larger per-agent stallMs helps.
# Only workflow agents are affected; the main session and ordinary subagents keep
# PROXY_KEEPALIVE_MS. 0 disables (stall returns). If a workflow sets a per-agent
# stallMs below this, lower the window to match.
PROXY_WORKFLOW_KEEPALIVE_MS=10000

# Declare a silent upstream wedged after this gap (covers a sparse 600s turn).
PROXY_UPSTREAM_BYTE_IDLE_MS=600000

# Codex /v1/responses (OpenAI Responses wire) only.
# PROXY_RESPONSES_KEEPALIVE_MS applies ONLY in early-commit mode (the default): the
# stream commits as soon as output appears, so this just bounds a silent start
# before committing + streaming keepalives. (With early-commit OFF the route buffers
# under PROXY_RESPONSES_BUFFER_MS instead.) Keep it below the Codex client's
# stream_idle_timeout_ms.
PROXY_RESPONSES_KEEPALIVE_MS=30000
# PROXY_RESPONSES_BUFFER_MS applies ONLY in full-buffer mode (early-commit off): the
# max buffering hold before a safety-valve live commit — the /v1/messages policy
# applied to Responses. It is Responses-owned (independent of PROXY_KEEPALIVE_MS) so
# a mixed Codex+Claude proxy tunes the two horizons separately. The Codex client's
# stream_idle_timeout_ms must strictly exceed it.
PROXY_RESPONSES_BUFFER_MS=600000
# PROXY_RESPONSES_EARLY_COMMIT: 1 (default) commits on the first output event and
# streams live, preserving streaming UX. Set 0 to buffer the whole response to
# response.completed like /v1/messages, under the PROXY_RESPONSES_BUFFER_MS hold —
# this extends the proxy's hidden-retry protection to MID-stream errors (not just
# start-of-stream), but the proxy forwards nothing until the turn ends, so the Codex
# client's stream_idle_timeout_ms MUST exceed that hold. Start-of-stream overloads
# are caught pre-commit either way.
#PROXY_RESPONSES_EARLY_COMMIT=1

# Retry policy (blind stabilizer): the proxy retries every transient failure
# (5xx, network, rate limits, capacity, auth, billing, unknown 4xx) by returning
# x-should-retry + Retry-After; it only surfaces deterministic request-shape
# errors (context too long, malformed tool blocks, schema, model-not-found).
#
# Claude Code 2.1.191 defaults to 10 retries and clamps CLAUDE_CODE_MAX_RETRIES
# to 15. To amplify beyond that, opt in to hidden proxy retries for uncommitted
# transactional /v1/messages attempts:
#   effective upstream attempts = (client retries + 1) * (PROXY_TRANSACTIONAL_LOCAL_RETRIES + 1)
#
# The hidden retry wait is upstream Retry-After plus proxy exponential extra
# backoff, capped by PROXY_LOCAL_RETRY_EXTRA_BACKOFF_CAP_MS.
PROXY_TRANSACTIONAL_LOCAL_RETRIES=0
PROXY_LOCAL_RETRY_EXTRA_BACKOFF_CAP_MS=10000

# PROXY_SDK_RETRY_CAP is only a backstop (default 100); 0 disables conversion.
#PROXY_SDK_RETRY_CAP=100

# Refusal fallback. When a request completes normally but the model DECLINES to
# answer (a complete stream whose stop_reason is "refusal"), or Fable returns a
# pre-stream safeguards block, the proxy silently re-issues the SAME request with
# this fallback model instead of handing the refusal back to the client, and logs
# one WARN line
#   (e.g. "WARN  claude-fable-5/main  refusal -> retry with claude-opus-5 ...").
# It fires at most once per request (the retried request already targets the
# fallback model, so a refusal from the fallback itself is delivered as-is) and
# only before anything is committed downstream (a refusal that arrives after a
# live commit is delivered unchanged). Every non-model field of the request is
# preserved exactly.
# Default: claude-opus-5. Set to off / none / empty to disable (refusals pass
# through). Stream refusal detection works even when PROXY_VALIDATE_JSON=0; full
# JSON validation is still recommended for malformed-stream conversion.
#PROXY_REFUSAL_FALLBACK_MODEL=claude-opus-5

# Optional: save each proxied request to one JSON archive in this dir. Request
# and response bodies are stored losslessly as base64 with size/SHA-256 metadata,
# including binary/image payloads. API-secret carriers such as Authorization,
# x-api-key, api_key, api_token, access_token, and client_secret are redacted;
# bodies are preserved exactly, so use a path you control. Leave unset to disable.
#PROXY_REQUEST_LOG_DIR=./logs
