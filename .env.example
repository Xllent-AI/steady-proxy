# Copy to .env (gitignored) and set your real values.
# docker compose reads .env automatically.

# The real gateway the proxy forwards to. Keep this out of version control.
PROXY_UPSTREAM_URL=https://your-gateway.example.com

# Transactional window. Stay buffered (cleanly convertible) up to this long,
# then commit + stream live. BOTH client-side abort timers MUST exceed it, or
# Claude aborts mid-hold. In ~/.claude/settings.json set:
#   CLAUDE_CODE_CONNECT_TIMEOUT_MS=660000   (TTFB / no-response-headers ceiling)
#   API_TIMEOUT_MS=720000                   (hard per-attempt request timeout)
#   API_FORCE_IDLE_TIMEOUT=0                (keep off; on kills a transactional hold)
PROXY_KEEPALIVE_MS=600000

# Declare a silent upstream wedged after this gap (covers a sparse 600s turn).
PROXY_UPSTREAM_BYTE_IDLE_MS=600000

# Retry policy (blind stabilizer): the proxy retries EVERY failure (5xx, network,
# rate limits, capacity, auth, billing, unknown 4xx) by returning x-should-retry
# + a Retry-After backoff; it only surfaces a request-shape error that can never
# succeed (context too long, malformed tool blocks, schema, model-not-found).
# The effective retry ceiling is your CLIENT's maxRetries — set it to how long you
# want to ride out an outage, e.g. in ~/.claude/settings.json:
#   API_MAX_RETRIES=30
# PROXY_SDK_RETRY_CAP is only a backstop (default 100); raise the client value,
# not this, to retry more.
#PROXY_SDK_RETRY_CAP=100

# Optional: save the full request + response of each call to a file in this dir
# (one human-readable file per request). Secrets in headers are redacted; bodies
# are capped at PROXY_REQUEST_LOG_MAX_BYTES. Prompts are written verbatim, so use
# a path you control. Leave unset to disable.
#PROXY_REQUEST_LOG_DIR=./logs
#PROXY_REQUEST_LOG_MAX_BYTES=10485760
